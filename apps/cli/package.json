{
  "name": "@forgecode/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "@types/react": "^18.3.3",
    "zod": "^3.23.8",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.0.0",
    "@forgecode/agent-runtime": "workspace:*",
    "@forgecode/ai-provider": "workspace:*",
    "@forgecode/tool-runtime": "workspace:*",
    "@forgecode/permission-engine": "workspace:*",
    "@forgecode/filesystem": "workspace:*",
    "@forgecode/shell": "workspace:*",
    "@forgecode/git": "workspace:*",
    "@forgecode/task-engine": "workspace:*",
    "@forgecode/agent-manager": "workspace:*",
    "@forgecode/memory": "workspace:*",
    "@forgecode/telemetry": "workspace:*",
    "@forgecode/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
